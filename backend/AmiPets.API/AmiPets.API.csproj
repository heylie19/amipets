    <PackageReference Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmiPets.Application\AmiPets.Application.csproj" />
